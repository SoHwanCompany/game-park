generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum GameStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum FeedbackCategory {
  BUG
  FEATURE
  GENERAL
  GAME_REQUEST
  OTHER
}

// ─── Auth.js Models ─────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique @db.VarChar(255)
  password        String?
  nickname        String     @unique @db.VarChar(50)
  profileUrl      String?
  role            UserRole   @default(USER)
  exp             Int        @default(0)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  accounts         Account[]
  sessions         Session[]
  gameLikes        GameLike[]
  rankings         Ranking[]
  feedbacks        Feedback[]
  feedbackComments FeedbackComment[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Game Platform Models ───────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(50)
  name        String   @unique @db.VarChar(100)
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  games Game[]

  @@map("categories")
}

model Game {
  id           String     @id @default(cuid())
  code         String     @unique @db.VarChar(50)
  title        String     @db.VarChar(200)
  description  String
  thumbnailUrl String     @map("thumbnail_url")
  gameUrl      String     @map("game_url")
  categoryId   String     @map("category_id")
  likeCount    Int        @default(0) @map("like_count")
  playCount    Int        @default(0) @map("play_count")
  status       GameStatus @default(DRAFT)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  category  Category   @relation(fields: [categoryId], references: [id])
  gameLikes GameLike[]
  rankings  Ranking[]

  @@index([categoryId])
  @@index([status])
  @@index([status, likeCount])
  @@index([status, playCount])
  @@index([status, createdAt])
  @@map("games")
}

model GameLike {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  gameId    String   @map("game_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
  @@map("game_likes")
}

model Ranking {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  gameId    String   @map("game_id")
  score     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, score(sort: Desc), updatedAt(sort: Asc)])
  @@map("rankings")
}

model Feedback {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  title          String           @db.VarChar(100)
  content        String
  category       FeedbackCategory @default(GENERAL)
  customCategory String?          @map("custom_category") @db.VarChar(50)
  isPublic       Boolean          @default(true) @map("is_public")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments FeedbackComment[]

  @@index([userId])
  @@index([isPublic, createdAt(sort: Desc)])
  @@map("feedbacks")
}

model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String   @map("feedback_id")
  userId     String   @map("user_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@map("feedback_comments")
}
